```{=html}
<% if (items.length === 0) { %>
<p class="post-empty">First post coming soon.</p>
<% } else { %>
<ul class="post-list">
<% for (const item of items) { %>
  <li <%= metadataAttrs(item) %>>
    <p class="post-title"><a href="<%- item.path %>"><%= item.title %></a></p>
    <% if (item.description) { %><p class="post-desc"><%= item.description %></p><% } %>
    <p class="post-meta">
      <%= item.date %><% if (item['reading-time']) { %> · <%= item['reading-time'] %><% } %><% if (item.categories && item.categories.length) { %> · <%= item.categories.join(', ') %><% } %>
    </p>
  </li>
<% } %>
</ul>
<% } %>
```
